{
  "name": "korbis-roulette",
  "private": true,
  "version": "1.0.0",
  "description": "Korbi's Roulette Logging – rolling number pool tracker for roulette (educational).",
  "author": "Master3307",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "sync": "pnpm build && cap sync android",
    "apk": "pnpm sync && node scripts/build-apk.mjs",
    "apk:install": "adb install -r dist-apk/KorbisRoulette-latest.apk",
    "icons": "capacitor-assets generate --android --iconBackgroundColor '#0b3d24' --iconBackgroundColorDark '#0b3d24' --splashBackgroundColor '#0b3d24' --splashBackgroundColorDark '#0b3d24'",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^5.0.1",
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^6.2.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19"
  }
}
